.npm/
.yarn/
.pnp.*
.yarnrc*
.nyc_output/
.vite/
.vite-temp/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build/test scratch generated by the frontend audit tooling
pc/tmp/
pc/var/

# Logs, process state, and editor/OS noise
*.log
*.log.*
*.pid
*.pid.lock
debug.log
logs/*
!logs/.gitkeep
**/logs/*
!**/logs/.gitkeep
.DS_Store
.AppleDouble
.LSOverride
._*
*.swp
*.swo
*~

# Local databases and their journal/WAL sidecars
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-*

# Project runtime data (the source code and dependency lockfiles remain tracked)
data/*
!data/.gitkeep
back/*
!back/.gitkeep
collector/data/*
!collector/data/.gitkeep
collector/.cache/
collector/**/raw/
collector/**/assets/
collector/**/profile/
collector/**/profiles/
collector/**/browser-profile/
collector/**/browser_profiles/
collector/**/playwright-profile/
collector/**/user-data/
collector/**/user_data/
service/caches/*
!service/caches/.gitkeep
service/vf_admin/*
!service/vf_admin/.gitkeep

# Generated documentation/build exports. Large source Word files are kept outside Git.
docs/_build/
docs/word/*.docx

