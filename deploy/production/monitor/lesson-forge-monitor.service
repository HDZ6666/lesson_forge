[Unit]
Description=Lesson Forge collection cycle observation (read-only application probes)
After=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
StateDirectory=lesson-forge-monitor
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/lesson-forge-monitor/monitor.py
TimeoutStartSec=75
Nice=10
IOSchedulingClass=idle
MemoryMax=128M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lesson-forge-monitor
