# Copy to .env and fill the existing deployment credentials locally.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=lesson_forge
MYSQL_USER=lesson_forge
MYSQL_PASSWORD=
REDIS_PASSWORD=
COLLECTOR_API_TOKEN=
JWT_SECRET_KEY=
# Record the deployed source commit; images receive the same revision label.
SOURCE_REVISION=
# Automatic plans stay off until the operator configures all required limits.
BANK_AUTOMATIC_SYNC_ENABLED=0
COLLECTOR_HEADFUL=true
# No-plan/manual task fallback; plans and task overrides have priority.
COLLECTOR_LIST_CONCURRENCY=8
COLLECTOR_ASSET_CONCURRENCY=2
COLLECTOR_DELAY_MIN_MS=4000
COLLECTOR_DELAY_MAX_MS=6000
COLLECTOR_SOURCE_DAILY_REQUEST_LIMIT=0
COLLECTOR_SOURCE_DAILY_BOOK_LIMIT=0
COLLECTOR_SOURCE_DAILY_ACTIVE_SECONDS=0
COLLECTOR_SOURCE_DAILY_DOWNLOAD_MIB=0
COLLECTOR_MIN_DISK_FREE_MIB=0
COLLECTOR_MIN_MEMORY_FREE_MIB=0
# 预警水位：低于它时在窗口间回收浏览器而不停止；保留水位需持续低于宽限期（毫秒）才停止。
COLLECTOR_SOFT_MEMORY_FREE_MIB=800
COLLECTOR_MEMORY_GRACE_MS=60000
# 浏览器回收：每 N 页，或 Chrome 进程树超过 N MB（0 关闭该条件）。
COLLECTOR_BROWSER_RECYCLE_PAGES=400
COLLECTOR_BROWSER_RECYCLE_MB=1000
BANK_MIN_DISK_FREE_MIB=0
BANK_MIN_MEMORY_FREE_MIB=0
BANK_SYNC_MAX_PENDING_IMPORTS=0

LESSON_UNDO_MINUTES=30

# 采集优先：启动新采集需要的可用内存；入库更早让出资源（MiB，0关闭该阈值）。
BANK_COLLECTION_START_MEMORY_MIB=1536
BANK_IMPORT_MIN_MEMORY_MIB=1024
# 旧成果入库结束至少保留24小时，且必须有更新的已封存成果、无待处理题/补采依赖。
BANK_RESULT_RETENTION_HOURS=24
