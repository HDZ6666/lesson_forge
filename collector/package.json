{
  "name": "lesson-bank-collector",
  "version": "0.1.0",
  "private": true,
  "description": "组卷网采集工程：限速抓取公开题库页面，结果写入本目录 SQLite 与素材，不写 MySQL",
  "scripts": {
    "start": "node server.cjs",
    "legacy:sync": "node legacy/zujuan_sync.cjs",
    "sync:zujuan:questions": "node zujuan_question_sync.cjs",
    "legacy:sync:book": "node legacy/zujuan_sync.cjs --acknowledge-source-policy --headful",
    "sync:zujuan:metadata": "node zujuan_metadata_sync.cjs",
    "legacy:sync:chapter5": "sh legacy/zujuan_sync.sh --all-catalogs --catalog-level 3 --within-chapter 261314 --max-pages ${ZUJUAN_MAX_PAGES:-3}",
    "legacy:sync:daily": "sh legacy/zujuan_sync_daily.sh",
    "qbpkg:build": "node qbpkg.cjs build",
    "qbpkg:verify": "node qbpkg.cjs verify",
    "test": "node --test tests/*.test.cjs",
    "check:undeclared": "node tests/tools/scan_undeclared.cjs",
    "format": "prettier --write \"*.cjs\" \"src/**/*.cjs\" \"lib/**/*.cjs\" \"tests/**/*.cjs\"",
    "format:check": "prettier --check \"*.cjs\" \"src/**/*.cjs\" \"lib/**/*.cjs\" \"tests/**/*.cjs\"",
    "check": "npm run check:undeclared && npm run format:check && npm test"
  },
  "engines": {
    "node": ">=22.5.0 <25"
  },
  "dependencies": {
    "playwright-core": "^1.62.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "prettier": "^3.9.10"
  }
}
